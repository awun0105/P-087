# Image GPU worker (ADR 0003 khối C) cho máy thuê dạng container: vast.ai, RunPod, hoặc Docker có NVIDIA runtime.
# Chứa trọn runtime pipeline (COLMAP 4.x, Brush, Node + splat-transform, LiDAR odometry, runtime tách theo vật, ObjectGS)
# và venv app. Không chứa frontend và không chứa secret.
#
# Mọi phiên bản và công thức cài nằm ở configs/runtime/pins.env và scripts/gpu/install.d/; file này không chép số phiên
# bản. Image dựng bằng install.sh (cùng công thức với laptop), ghi /opt/real2sim/runtime.env, và entrypoint chỉ nạp file đó.
#
#   docker build -f Dockerfile.gpu \
#     --build-arg COLMAP_IMAGE="$(sed -n 's/^COLMAP_IMAGE=//p' configs/runtime/pins.env)" \
#     -t <registry>/real2sim-gpu:<tag> .
#   docker run --gpus all -e DATABASE_URL=... -e ARTIFACT_S3_BUCKET=... <image> worker
#
# COLMAP: lấy đúng cây nhị phân từ image ghim (cùng digest với máy local), đặt tại /opt/real2sim/colmap và gọi qua
# colmap-run. Không cần Docker trong container.
#
# CHƯA build thật: T-038 chỉ kiểm tĩnh (máy dev thiếu ổ đĩa). Build thật làm ở T-039.
ARG COLMAP_IMAGE
FROM ${COLMAP_IMAGE} AS colmap
# Cây COLMAP đúng layout của gói nhị phân (colmap/bin, colmap/lib). `cp -L`: chép file thật, không chép symlink.
RUN mkdir -p /export/colmap/bin /export/colmap/lib \
    && cp /usr/local/bin/colmap /export/colmap/bin/colmap \
    && cp -L /usr/local/lib/libonnxruntime.so.1 /usr/local/lib/libonnxruntime_providers_shared.so /export/colmap/lib/ \
    && cp -L /usr/local/cuda/lib64/libcudart.so.12 /usr/local/cuda/lib64/libOpenCL.so.1 /export/colmap/lib/

FROM nvidia/cuda:12.6.3-devel-ubuntu24.04 AS pipeline

# `all` để NVIDIA runtime mount cả thư viện đồ hoạ: Brush và splat-transform cần Vulkan trên GPU.
# TORCH_CUDA_ARCH_LIST: build không có GPU nên không dò được kiến trúc; runtime cũng nhận đúng giá trị này.
ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    R2S_ROOT=/opt/real2sim \
    R2S_STATE=/data \
    TORCH_EXTENSIONS_DIR=/opt/real2sim/torch_extensions \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9" \
    TORCH_HOME=/opt/real2sim/torch_cache \
    UV_PYTHON_INSTALL_DIR=/opt/real2sim/python

WORKDIR /opt/real2sim/app

# Gói apt của runtime: cùng danh sách với install.sh --check-system.
COPY configs/runtime/apt-packages.txt configs/runtime/apt-packages.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends $(grep -v '^#' configs/runtime/apt-packages.txt) \
    && rm -rf /var/lib/apt/lists/*

COPY --from=colmap /export/colmap /opt/real2sim/colmap
# uv 0.9.4 predates the managed Python 3.12.14 required below.
COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /usr/local/bin/uv

# Runtime GPU: install.sh là nơi duy nhất cài và ghi đường dẫn. Chỉ chép những file nó cần để lớp cache không vỡ
# khi đổi code app.
COPY configs/runtime/ configs/runtime/
COPY requirements-lidar-odometry.lock.txt ./
COPY src/services/scene/objectgs.py src/services/scene/objectgs.py
COPY scripts/gpu/install.sh scripts/gpu/doctor.sh scripts/gpu/setup_scene_runtime.sh scripts/gpu/setup_objectgs_runtime.sh scripts/gpu/
COPY scripts/gpu/install.d/ scripts/gpu/install.d/
# ObjectGS verification imports preflight, which imports src.runtime_env.
COPY scripts/kaggle/preflight.py scripts/kaggle/preflight.py
COPY src/runtime_env.py src/runtime_env.py

# Venv của app theo lockfile (lớp cache riêng: đổi code không cài lại).
COPY requirements.lock.txt ./
RUN uv venv --python 3.12.14 .venv \
    && uv pip sync --python .venv/bin/python --require-hashes requirements.lock.txt \
    && uv pip check --python .venv/bin/python

# Mỗi runtime tự lấy header của chính Python của nó (scene: 3.12, ObjectGS: 3.8); không đặt CPATH chung ở đây,
# vì CPATH 3.12 làm gsplat của ObjectGS biên dịch sai header. Không có GPU lúc build: kiểm gsplat không đòi GPU.
RUN scripts/gpu/install.sh /opt/real2sim --colmap=binary --skip-gpu-check --no-doctor \
    && uv cache clean

# Từ điển khép vòng của COLMAP (T-071 B1), bake vào image tại vị trí chuẩn mà vocab_tree.py đọc
# (<repo>/data/checkpoints/colmap/). Định dạng theo COLMAP_VOCAB_FORMAT trong pins.env; script tải chỉ công bố file
# khi đúng kích thước và sha256 ghim trong vocab_tree.py, sai là build lỗi. `data/` không nằm trong build context
# (.dockerignore) nên `COPY . .` phía sau không đè lên file này. Không tải lúc khởi động: file cố định theo COLMAP
# của image.
COPY src/services/reconstruction/adapters/vocab_tree.py src/services/reconstruction/adapters/vocab_tree.py
COPY scripts/assets/download_vocab_tree.py scripts/assets/download_vocab_tree.py
RUN format="$(sed -n 's/^COLMAP_VOCAB_FORMAT=//p' configs/runtime/pins.env)" \
    && test -n "$format" \
    && .venv/bin/python scripts/assets/download_vocab_tree.py --format "$format" --timeout 120 \
    && .venv/bin/python scripts/assets/download_vocab_tree.py --format "$format" --check-only \
    && rm -f data/checkpoints/colmap/*.lock

# Quyền chạy lấy từ git (100755), không cần RUN chmod: lớp code là lớp duy nhất đổi giữa hai lần build, nên
# build có cache chỉ đóng lớp này mà không phải tải các lớp runtime nặng phía trước về để chạy lệnh.
COPY . .
ENV R2S_REQUIRE_FULL_RUNTIME=1

VOLUME ["/data"]
EXPOSE 8000
ENTRYPOINT ["scripts/gpu/docker_entrypoint.sh"]
CMD ["worker"]

# Optional full pipeline + Isaac image. Select --target isaac explicitly.
# The operator must accept the NVIDIA license; the default image needs no Isaac download.
FROM pipeline AS isaac
ARG ISAAC_ACCEPT_EULA=NO
RUN ISAAC_ACCEPT_EULA="$ISAAC_ACCEPT_EULA" bash scripts/gpu/setup_isaac_runtime.sh /opt/real2sim/isaac_runtime
ENV PRODUCT_ISAAC_VALIDATION_LAUNCHER=/opt/real2sim/app/scripts/gpu/isaac_python.sh

FROM pipeline AS production
