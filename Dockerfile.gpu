# Image GPU worker (ADR 0003 khối C) cho máy thuê dạng container: vast.ai, RunPod, hoặc Docker có NVIDIA runtime.
# Chứa trọn runtime pipeline: COLMAP (bản apt, chạy CPU), Brush, Node + splat-transform, venv app, runtime tách
# theo vật (torch + SAM2 + gsplat + CoACD + LaMa). Không chứa frontend và không chứa secret.
#
#   docker build -f Dockerfile.gpu -t <registry>/real2sim-gpu:<tag> .
#   docker run --gpus all -e DATABASE_URL=... -e ARTIFACT_S3_BUCKET=... <image> worker
#
# CHƯA build/chạy thật (2026-10-01): máy dev không đủ ổ đĩa. Lần build đầu chạy `preflight` trong container.
FROM nvidia/cuda:12.6.3-devel-ubuntu22.04

ARG BRUSH_VERSION=0.3.0
ARG BRUSH_SHA=4f0f9a8785d1951c62df26aae247c02c5bba32b00f40b06df4e1c9b867399e20
ARG NODE_VERSION=v22.20.0
ARG SPLAT_TRANSFORM_VERSION=3.6.6

# `all` để NVIDIA runtime mount cả thư viện đồ hoạ: Brush và splat-transform cần Vulkan trên GPU.
ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    R2S_RUNTIME=/opt/real2sim/runtime \
    R2S_SCENE_RUNTIME=/opt/real2sim/scene_runtime \
    R2S_STATE=/data \
    TORCH_EXTENSIONS_DIR=/opt/real2sim/torch_extensions \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9" \
    UV_PYTHON_INSTALL_DIR=/opt/real2sim/python \
    PATH=/opt/real2sim/runtime/node/bin:/usr/local/cuda/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       colmap ffmpeg libvulkan1 vulkan-tools xz-utils curl git ca-certificates libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.4 /uv /usr/local/bin/uv

# Brush + Node + splat-transform (ghim phiên bản như máy local, xem scripts/gpu/README.md §2).
RUN mkdir -p "$R2S_RUNTIME/brush" "$R2S_RUNTIME/node" \
    && curl -L --fail -o /tmp/brush.tar.xz \
       "https://github.com/ArthurBrussee/brush/releases/download/v${BRUSH_VERSION}/brush-app-x86_64-unknown-linux-gnu.tar.xz" \
    && echo "${BRUSH_SHA}  /tmp/brush.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/brush.tar.xz -C "$R2S_RUNTIME/brush" --strip-components=1 \
    && curl -L --fail -o /tmp/node.tar.xz "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz" \
    && tar -xJf /tmp/node.tar.xz -C "$R2S_RUNTIME/node" --strip-components=1 \
    && rm /tmp/brush.tar.xz /tmp/node.tar.xz \
    && cd "$R2S_RUNTIME" && npm install --silent "@playcanvas/splat-transform@${SPLAT_TRANSFORM_VERSION}"

WORKDIR /opt/real2sim/app

# Dependency của app theo lockfile (lớp cache riêng: đổi code không cài lại).
COPY requirements.lock.txt ./
RUN uv venv --python 3.12 .venv && uv pip sync --python .venv/bin/python requirements.lock.txt

# Runtime tách theo vật; kernel CUDA của gsplat được biên dịch sẵn (không cần GPU lúc build).
COPY scripts/gpu/setup_scene_runtime.sh scripts/gpu/setup_scene_runtime.sh
RUN CPATH="$(.venv/bin/python -c "import sysconfig; print(sysconfig.get_paths()['include'])")" \
    R2S_SKIP_GPU_CHECK=1 MAX_JOBS=4 bash scripts/gpu/setup_scene_runtime.sh "$R2S_SCENE_RUNTIME" \
    && uv cache clean

COPY . .
RUN chmod +x scripts/gpu/docker_entrypoint.sh

VOLUME ["/data"]
EXPOSE 8000
ENTRYPOINT ["scripts/gpu/docker_entrypoint.sh"]
CMD ["worker"]
