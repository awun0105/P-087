# ============================================
# AI20K Project — Environment Variables
# ============================================
# Sao chép file này thành .env rồi điền các giá trị cần thiết
# TUYỆT ĐỐI KHÔNG commit file .env lên Git!

# ---- Cấu hình LLM ----
# Provider đang sử dụng: openai | anthropic | google | openrouter | nvidia_nim | mistral
LLM_PROVIDER=openai

# Cấu hình sinh nội dung dùng chung
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ---- Cấu hình ứng dụng ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Cơ sở dữ liệu ----
DATABASE_URL=sqlite:///./data/app.db
# Dùng SQLite trong môi trường phát triển:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Kho vector ----
CHROMA_PERSIST_DIR=./data/chroma
# Hoặc sử dụng Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Artifact store ----
# Production/deployment phải cấu hình absolute path. Development có thể dùng default này.
ARTIFACT_ROOT=./data/artifacts

# ---- Kho file S3-compatible (ADR 0003; để trống = chỉ filesystem local) ----
# R2: endpoint https://<account_id>.r2.cloudflarestorage.com, region auto.
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_ENDPOINT=
# ARTIFACT_S3_REGION=auto
# ARTIFACT_S3_ACCESS_KEY_ID=
# ARTIFACT_S3_SECRET_ACCESS_KEY=
# ARTIFACT_S3_PREFIX=
# ARTIFACT_PRESIGN_SECONDS=900

# ---- Đăng nhập và Guest signup ----
# Bật trên deployment cloud; tạo Reviewer đầu tiên:
#   python -m src.services.orchestration.auth.cli create-user --email ... --name ... --role reviewer
AUTH_REQUIRED=false
# Không có mã mời thì đăng ký Guest; đặt false nếu muốn chỉ cho đăng ký bằng lời mời.
AUTH_GUEST_SIGNUP_ENABLED=true
# AUTH_SESSION_DAYS=7
# AUTH_INVITE_DAYS=7

# ---- Benchmark (plan Cloud Studio mục 9) ----
# BENCHMARK_GPU_HOURLY_USD=0.34
# BENCHMARK_LABEL=

# Synthetic fixture chỉ để demo development; mặc định API không seed dữ liệu giả.
PRODUCT_FIXTURE_MODE=false
# Job thật cần cả hai profile files; không tự dùng config/version của fixture.
# PRODUCT_PROCESSING_CONFIG=/absolute/path/processing_config.json
# PRODUCT_RUNTIME_MANIFEST=/absolute/path/runtime_manifest.json
# Optional checksum-verified registry for unified input recipes; mount the same
# registry in API and worker. Missing registry keeps new dispatch unavailable.
# PRODUCT_INPUT_RUNTIME_REGISTRY=/absolute/path/input_runtime_registry.json
# PRODUCT_SEED=7
PRODUCT_WORKER_ROOT=./data/product_workers
PRODUCT_PREVIEW_TIMEOUT_SECONDS=21600
# Prepared worker profile JSON có đúng hai keys: colmap và brush (REC configs).
# Chạy worker ngoài HTTP sau khi job đã có NormalizedRGBFrameSet:
# python -m src.services.orchestration.jobs.runner --job-id JOB --frame-set-uri artifact://jobs/JOB/frames.json
# PostgreSQL deployment cần psycopg 3 và DATABASE_URL do operator cấu hình.

# ---- LangSmith (nhật ký AI — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Ghi log ----
LOG_LEVEL=INFO

# ---- Ghi log qua AI Hook (do giảng viên cung cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (nếu được tách riêng) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
