# Phiên bản ghim của runtime GPU: đọc bởi scripts/gpu/install.sh, install.d/*.sh, doctor.sh và (từ T-038 bước 4)
# Dockerfile.gpu. Mỗi công cụ chỉ có một chỗ ghim ở đây. Ngoại lệ có chủ đích: SAM2/LaMa/MoGe ghim trong
# scripts/gpu/setup_scene_runtime.sh và commit ObjectGS ghim trong src/services/scene/objectgs.py.
# Định dạng: KHOA=giá_trị, một dòng, không dấu nháy, không khoảng trắng quanh dấu "=".

# Brush (ArthurBrussee/brush, release v0.3.0): archive tar.xz; sha256 của archive.
BRUSH_VERSION=0.3.0
BRUSH_SHA=4f0f9a8785d1951c62df26aae247c02c5bba32b00f40b06df4e1c9b867399e20

# Node.js 22 (nodejs.org/dist): archive linux-x64; sha256 lấy từ SHASUMS256.txt chính thức của bản đó.
NODE_VERSION=v22.20.0
NODE_SHA=00bbd05e306ea68b6e13e17360d0e2f680b493ef95f2fea1c4296ff7437530bc

# splat-transform (npm @playcanvas/splat-transform): npm kiểm integrity của gói theo package-lock.
SPLAT_TRANSFORM_VERSION=3.6.6

# COLMAP 4.x: image chính thức ghim theo digest (cùng digest với máy local dùng qua docker).
COLMAP_IMAGE=colmap/colmap@sha256:b8498ebecab11c3f9b9a25370e3fcfb6de9b6bcd4f3c85d5dc39a40229f40954

# KISS-ICP (odometry LiDAR): phiên bản khoá trong requirements-lidar-odometry.lock.txt.
KISS_ICP_VERSION=1.3.0

# Optional Isaac build target: Python 3.11; not installed by the default GPU image.
ISAAC_VERSION=5.1.0

# micromamba 2.0.5 (mamba-org/micromamba-releases, release 2.0.5-0), dùng để tạo prefix conda của ObjectGS.
# sha256 của tarball (khớp kích thước trong GitHub API). Tệp .tar.bz2.sha256 của release ghi sha của binary, nên
# binary bên trong được kiểm riêng theo MICROMAMBA_BIN_SHA (khớp file micromamba-linux-64.sha256 của release).
MICROMAMBA_URL=https://github.com/mamba-org/micromamba-releases/releases/download/2.0.5-0/micromamba-linux-64.tar.bz2
MICROMAMBA_SHA=bfc2e3a414d651af7508c49998a12b5cf3c7029d56c5ef37c9a3248cd7faef78
MICROMAMBA_BIN_SHA=cdf5a2e18d213617b6c5c32d8763b4e8fc05f8173b4f4017997683cb984357eb

# Giấy phép đi kèm gói nhị phân COLMAP. Image ghim không chứa file giấy phép, nên lấy từ kho mã chính thức và ghim sha256.
COLMAP_LICENSE_URL=https://raw.githubusercontent.com/colmap/colmap/main/LICENSE
COLMAP_LICENSE_SHA=b427b1780b9c1d5996a641597b35d6c97163316bf6b15f7f7bc27518d3dd8b36
ONNXRUNTIME_LICENSE_URL=https://raw.githubusercontent.com/microsoft/onnxruntime/v1.27.1/LICENSE
ONNXRUNTIME_LICENSE_SHA=2f07c72751aed99790b8a4869cf2311df85a860b22ded05fa22803587a48922c

# Gói nhị phân COLMAP (scripts/gpu/export_colmap_binary.sh xuất từ COLMAP_IMAGE ở trên): sha256 của tệp .tar.zst.
COLMAP_BINARY_SHA=9dcb18e2c856ae2657f09ca7991e1c14c8348ac7b411d8cf7127c86ef9954438
