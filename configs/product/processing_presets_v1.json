      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "simulation.dynamic_friction",
      "group": "simulation",
      "label": "Ma sát động mặc định",
      "description": "Áp dụng cho vật thể chưa có vật liệu vật lý riêng.",
      "kind": "number",
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "simulation.restitution",
      "group": "simulation",
      "label": "Độ nảy mặc định",
      "description": "0 không nảy; 1 giữ độ nảy tối đa của mô hình vật lý.",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "simulation.carve_margin_m",
      "group": "simulation",
      "label": "Khoảng nới khi khoét nền",
      "description": "Nới hộp vật thể khi loại vùng nền trùng collider.",
      "kind": "number",
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "scene.geometry_method",
      "group": "scene",
      "label": "Hình học theo vật",
      "description": "ObjectGS cần runtime riêng; lỗi không tự chuyển sang collider cũ.",
      "kind": "choice",
      "choices": [
        {
          "value": "legacy",
          "label": "Legacy"
        },
        {
          "value": "objectgs",
          "label": "ObjectGS"
        }
      ]
    },
    {
      "key": "scene.objectgs_iterations",
      "group": "scene",
      "label": "Vòng huấn luyện ObjectGS",
      "description": "Số vòng tạo checkpoint ObjectGS trước khi xuất surface mesh.",
