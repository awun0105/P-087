{
  "schema_version": "1.0",
  "profile_id": "product.processing_presets_v1",
  "parameters": [
    {
      "key": "sampling.sample_fps",
      "group": "sampling",
      "label": "Khung hình lấy mỗi giây video",
      "description": "Video được lấy mẫu theo thời lượng: số frame = thời lượng × giá trị này (chặn bởi số frame tối đa). Trong mỗi khoảng, hệ thống giữ frame nét nhất. Đi chậm quay 2–4 fps là đủ chồng lặp cho COLMAP.",
      "kind": "number",
      "unit": "fps",
      "min": 0.5,
      "max": 10,
      "step": 0.5
    },
    {
      "key": "sampling.max_frames",
      "group": "sampling",
      "label": "Số khung hình tối đa",
      "description": "Trần số ảnh đưa vào COLMAP và huấn luyện. Nhiều ảnh phủ khu vực rộng hơn nhưng tăng thời gian, RAM và dung lượng đĩa.",
      "kind": "integer",
      "unit": "frame",
      "min": 30,
      "max": 2000,
      "step": 10
    },
    {
      "key": "colmap.camera_model",
      "group": "colmap",
      "label": "Mô hình camera",
      "description": "SIMPLE_RADIAL hợp với điện thoại/camera thường. OPENCV mô tả méo ống kính kỹ hơn (camera góc rộng) nhưng cần nhiều ảnh tốt hơn để hội tụ.",
      "kind": "choice",
      "choices": [
        {
          "value": "SIMPLE_RADIAL",
          "label": "SIMPLE_RADIAL · camera thường"
        },
        {
          "value": "OPENCV",
          "label": "OPENCV · ống kính góc rộng"
        }
      ]
    },
    {
      "key": "colmap.max_image_size",
      "group": "colmap",
      "label": "Cạnh ảnh tối đa khi tìm đặc trưng",
      "description": "COLMAP thu nhỏ ảnh về cạnh này trước khi trích xuất đặc trưng. Lớn hơn → vị trí camera chính xác hơn, chậm hơn và tốn RAM hơn.",
      "kind": "integer",
      "unit": "px",
      "min": 640,
      "max": 3200,
      "step": 160
    },
    {
      "key": "colmap.max_num_features",
      "group": "colmap",
      "label": "Số điểm đặc trưng mỗi ảnh",
      "description": "Nhiều điểm đặc trưng giúp khớp ảnh ở cảnh ít chi tiết (tường trơn, kệ lặp lại) nhưng tăng thời gian khớp và RAM.",
      "kind": "integer",
      "unit": "điểm",
      "min": 1024,
      "max": 32768,
      "step": 1024
    },
    {
      "key": "colmap.sequential_overlap",
      "group": "colmap",
      "label": "Số ảnh lân cận để so khớp",
      "description": "Mỗi ảnh được so với chừng này ảnh kế tiếp trong video. Tăng khi camera đi nhanh hoặc quay vòng.",
      "kind": "integer",
      "unit": "ảnh",
      "min": 3,
      "max": 30,
      "step": 1
    },
    {
      "key": "brush.total_train_iters",
      "group": "brush",
      "label": "Số bước huấn luyện 3DGS",
      "description": "30.000 bước là mức chuẩn của 3D Gaussian Splatting. Nhiều bước hơn cải thiện chi tiết nhỏ nhưng thời gian tăng gần tuyến tính.",
      "kind": "integer",
      "unit": "bước",
      "min": 1000,
      "max": 60000,
      "step": 1000
    },
    {
      "key": "brush.max_resolution",
      "group": "brush",
      "label": "Độ phân giải huấn luyện",
      "description": "Cạnh dài tối đa của ảnh khi huấn luyện. Cao hơn → scene sắc nét hơn, tốn VRAM GPU hơn.",
      "kind": "integer",
      "unit": "px",
      "min": 480,
      "max": 3840,
      "step": 160
    },
    {
      "key": "brush.max_splats",
      "group": "brush",
      "label": "Số Gaussian tối đa",
      "description": "Giới hạn số điểm 3D Gaussian. Nhiều hơn → chi tiết hơn nhưng tốn VRAM khi huấn luyện và file scene nặng hơn khi xem trên trình duyệt.",
      "kind": "integer",
      "unit": "Gaussian",
      "min": 100000,
      "max": 8000000,
      "step": 100000
    },
    {
      "key": "brush.sh_degree",
      "group": "brush",
      "label": "Bậc spherical harmonics",
      "description": "Bậc 3 tái hiện màu thay đổi theo góc nhìn (phản chiếu nhẹ). Bậc thấp nhẹ hơn nhưng màu phẳng hơn.",
      "kind": "integer",
      "unit": "bậc",
      "min": 0,
      "max": 3,
      "step": 1
    },
    {
      "key": "brush.sog_iterations",
      "group": "brush",
      "label": "Số vòng nén SOG",
      "description": "Số vòng k-means khi nén scene sang SOG để xem trên web. Nén chạy trên GPU của máy xử lý (WebGPU); không có GPU thì lùi về CPU và chậm hơn rất nhiều. Nhiều vòng → nén đẹp hơn, xuất chậm hơn.",
      "kind": "integer",
      "unit": "vòng",
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "key": "colmap.matching_mode",
      "group": "colmap",
      "label": "Cách ghép ảnh",
      "description": "Ghép liên tiếp cho video; khép vòng cần vocabulary tree đã cài trên worker; ghép mọi cặp cho bộ ảnh.",
      "kind": "choice",
      "choices": [
        {
          "value": "sequential",
          "label": "Liên tiếp"
        },
        {
          "value": "sequential_vocab_tree",
          "label": "Liên tiếp và khép vòng"
        },
        {
          "value": "exhaustive",
          "label": "Mọi cặp ảnh"
        }
      ]
    },
    {
      "key": "colmap.loop_detection_period",
      "group": "colmap",
      "label": "Chu kỳ tìm khép vòng",
      "description": "Số ảnh giữa hai lần tìm lại khu vực đã quay; chỉ áp dụng khi bật khép vòng.",
      "kind": "integer",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "ảnh"
    },
    {
      "key": "colmap.loop_detection_num_images",
      "group": "colmap",
      "label": "Ảnh ứng viên khép vòng",
      "description": "Số ảnh ứng viên được tìm cho mỗi lần khép vòng.",
      "kind": "integer",
      "min": 1,
      "max": 200,
      "step": 1,
      "unit": "ảnh"
    },
    {
      "key": "colmap.loop_detection_min_index_distance",
      "group": "colmap",
      "label": "Khoảng cách ảnh tối thiểu",
      "description": "Khoảng cách chỉ số ảnh tối thiểu khi tìm khép vòng.",
      "kind": "integer",
      "min": 1,
      "max": 200,
      "step": 1,
      "unit": "ảnh"
    },
    {
      "key": "geometry.collision_mesh",
      "group": "geometry",
      "label": "Kiểu lưới va chạm",
      "description": "Lưới mượt giảm bậc thang; mặt voxel giữ hình dạng ô lưới.",
      "kind": "choice",
      "choices": [
        {
          "value": "smooth",
          "label": "Mượt"
        },
        {
          "value": "faces",
          "label": "Mặt voxel"
        }
      ]
    },
    {
      "key": "geometry.resolution_m",
      "group": "geometry",
      "label": "Kích thước voxel",
      "description": "Ô nhỏ giữ nhiều chi tiết hơn nhưng tăng bộ nhớ khi dựng lưới.",
      "kind": "number",
      "min": 0.02,
      "max": 0.2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "geometry.external_fill_size_m",
      "group": "geometry",
      "label": "Lấp vùng bên ngoài",
      "description": "Độ rộng lấp vùng bên ngoài trước khi tạo lưới; 0 là tắt.",
      "kind": "number",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "geometry.floor_fill_size_m",
      "group": "geometry",
      "label": "Lấp sàn",
      "description": "Độ rộng lấp sàn trước khi tạo lưới; 0 là tắt.",
      "kind": "number",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "m"
    },
    {
      "key": "scene.max_objects",
      "group": "scene",
      "label": "Số vật thể tối đa",
      "description": "Giới hạn số vật thể giữ lại từ kết quả phân đoạn; chọn 1 khi chỉ quét một vật.",
      "kind": "integer",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "vật"
    },
    {
      "key": "scene.min_score",
      "group": "scene",
      "label": "Ngưỡng tin cậy mask",
      "description": "Chỉ giữ mask có độ tin cậy đạt ngưỡng.",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "scene.max_area",
      "group": "scene",
      "label": "Tỉ lệ diện tích mask tối đa",
      "description": "Bỏ mask chiếm quá nhiều diện tích ảnh để hạn chế nhận nhầm nền thành vật.",
      "kind": "number",
      "min": 0.01,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "scene.box_margin_m",
      "group": "scene",
      "label": "Nới hộp vật thể",
      "description": "Khoảng nới quanh hộp khi gán Gaussian cho vật thể.",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "scene.sam_batch",
      "group": "scene",
      "label": "Số vật thể mỗi lô SAM2",
      "description": "Lô lớn có thể nhanh hơn nhưng dùng nhiều VRAM hơn.",
      "kind": "integer",
      "min": 1,
      "max": 64,
      "step": 1,
      "unit": "vật"
    },
    {
      "key": "scene.coacd_threshold",
      "group": "scene",
      "label": "Ngưỡng phân rã collider",
      "description": "Ngưỡng phân rã lưới thành các khối lồi cho va chạm.",
      "kind": "number",
      "min": 0.01,
      "max": 1,
      "step": 0.01
    },
    {
      "key": "scene.coacd_max_convex_hull",
      "group": "scene",
      "label": "Số khối lồi tối đa",
      "description": "Giới hạn số khối lồi trên mỗi vật thể.",
      "kind": "integer",
      "min": 1,
      "max": 64,
      "step": 1,
      "unit": "khối"
    },
    {
      "key": "scene.coacd_preprocess_resolution",
      "group": "scene",
      "label": "Độ phân giải tiền xử lý collider",
      "description": "Độ phân giải tiền xử lý trước khi phân rã khối lồi.",
      "kind": "integer",
      "min": 10,
      "max": 100,
      "step": 1
    },
    {
      "key": "scene.coacd_voxel_m",
      "group": "scene",
      "label": "Voxel collider vật thể",
      "description": "Kích thước voxel khi tạo collider riêng cho vật thể.",
      "kind": "number",
      "min": 0.01,
      "max": 0.2,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "scene.inpaint_max_new_gaussians",
      "group": "scene",
      "label": "Gaussian vá nền tối đa",
      "description": "Giới hạn số Gaussian bổ sung sau khi tách vật khỏi nền.",
      "kind": "integer",
      "min": 0,
      "max": 1000000,
      "step": 10000,
      "unit": "Gaussian"
    },
    {
      "key": "scene.inpaint_behind_object_m",
      "group": "scene",
      "label": "Khoảng lùi nền vá",
      "description": "Khoảng đặt vùng nền bổ sung phía sau vật thể.",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "unit": "m"
    },
    {
      "key": "simulation.ground_plane",
      "group": "simulation",
      "label": "Mặt phẳng sàn vật lý",
      "description": "Thêm mặt phẳng sàn tại cao độ 0 khi xuất gói mô phỏng.",
      "kind": "choice",
      "choices": [
        {
          "value": "enabled",
          "label": "Bật"
        },
        {
          "value": "disabled",
          "label": "Tắt"
        }
      ]
    },
    {
      "key": "simulation.static_friction",
      "group": "simulation",
      "label": "Ma sát tĩnh mặc định",
      "description": "Áp dụng cho vật thể chưa có vật liệu vật lý riêng.",
