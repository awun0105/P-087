# ─────────────────────────────────────────────────────────────────────────────
# Makefile của Studio (video → 3DGS → scene). KHÔNG ghi đè Makefile gốc của ban tổ chức.
#
# Máy mới (teammate) — một lệnh, không cần sửa đường dẫn nào:
#
#   make -f Makefile.studio start                      # cài mọi thứ + bật API, worker, web
#   make -f Makefile.studio start DATA=r2s-studio-data.tar.gz   # như trên, khôi phục dữ liệu trước khi bật
#
# Lệnh lẻ:
#   make -f Makefile.studio setup          # cài Python + frontend (+ runtime xử lý nếu máy có GPU NVIDIA và Docker)
#   make -f Makefile.studio setup-runtime  # buộc cài runtime xử lý (Brush, splat-transform, image COLMAP)
#   make -f Makefile.studio up             # bật FastAPI + queue worker + Next.js
#   make -f Makefile.studio down           # kill process đang giữ port
#   make -f Makefile.studio status         # xem port nào đang giữ
#   make -f Makefile.studio env            # sinh scripts/gpu/studio.env theo checkout của máy này
#   make -f Makefile.studio data-pack      # đóng gói dữ liệu để gửi teammate
#   make -f Makefile.studio data-unpack DATA=<file>    # khôi phục gói dữ liệu
#   make -f Makefile.studio account EMAIL=... NAME=... # tạo tài khoản Reviewer (khi bật AUTH_REQUIRED)
#   make -f Makefile.studio docker         # chạy bằng Docker (chỉ xem, không cần cài Python/Node)
#
# Quy tắc của file này:
#   1. Không có đường dẫn của máy nào viết cứng: mọi thứ suy từ thư mục checkout.
#   2. Chỉ bind vào port TRỐNG — tự dò lên từ API_PORT/WEB_PORT, in ra port chọn được.
#   3. Ctrl+C hoặc `down` → kill đúng các tiến trình đang giữ port của stack này.
#   4. Không ghi đè file env đã tồn tại trừ khi FORCE_ENV=1 (bản cũ được sao lưu).
#   5. Máy không có runtime xử lý (không GPU) vẫn bật được ở chế độ chỉ xem: không có worker, không chạy job mới.
# ─────────────────────────────────────────────────────────────────────────────

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.ONESHELL:
.DEFAULT_GOAL := help

ROOT       := $(CURDIR)
ENV_FILE   := $(ROOT)/scripts/gpu/studio.env
STACK      := $(ROOT)/scripts/gpu/run_stack.sh
VENV_PY    := $(ROOT)/.venv/bin/python
PORT_STATE := $(ROOT)/data/studio_local/studio-ports.env

API_PORT      ?= 8010
WEB_PORT      ?= 3010
PORT_SCAN     ?= 20
FRONTEND_MODE ?= dev
DEMO_DIR      ?= $(ROOT)/data/demo/library
BRUSH  := $(ROOT)/data/rec04_runtime/brush/brush-app-x86_64-unknown-linux-gnu/brush_app
SPLAT  := $(ROOT)/data/rec04_runtime/node_modules/@playcanvas/splat-transform/dist/index.mjs
COLMAP := $(ROOT)/data/rec04_runtime/colmap-launcher.sh

# Hàm dùng chung cho các target (make mở rộng $ → $$).
define PORT_HELPERS
port_busy() { ss -ltnH "sport = :$$1" 2>/dev/null | grep -q .; }
port_owner() { fuser -n tcp "$$1" 2>/dev/null || true; }
port_free_from() {
  local port="$$1" tried=0
  while [ "$$tried" -lt "$(PORT_SCAN)" ]; do
    if ! port_busy "$$port"; then echo "$$port"; return 0; fi
    tried=$$((tried + 1)); port=$$((port + 1))
  done
  echo ""
}
free_port_or_die() {
  local label="$$1" start="$$2" chosen
  chosen=$$(port_free_from "$$start")
  if [ -z "$$chosen" ]; then
    echo "[!] Không còn port trống cho $$label trong $$start..$$((start + $(PORT_SCAN) - 1))." >&2
    echo "    Thử: make -f Makefile.studio up API_PORT=9000 WEB_PORT=3000" >&2
    exit 1
  fi
  if [ "$$chosen" != "$$start" ]; then
    echo "[!] $$label: port $$start đang bị PID $$(port_owner "$$start") chiếm → dùng $$chosen." >&2
  fi
  echo "$$chosen"
}
kill_port() {
  local port="$$1"
  if ! port_busy "$$port"; then echo "[stop] port $$port đã trống."; return 0; fi
  local pids; pids=$$(port_owner "$$port")
  echo "[stop] kill port $$port (PID $$pids)"
  fuser -k -TERM -n tcp "$$port" >/dev/null 2>&1 || true
}
endef

.PHONY: help start setup setup-runtime up down status env data-pack data-unpack account samples docker docker-down

help:
	@echo "Studio — lệnh có sẵn:"
	@echo "  make -f Makefile.studio start [DATA=goi.tar.gz]  # máy mới: cài + khôi phục dữ liệu + bật tất cả"
	@echo "  make -f Makefile.studio setup          # cài Python + frontend (+ runtime xử lý nếu có GPU NVIDIA và Docker)"
	@echo "  make -f Makefile.studio setup-runtime  # buộc cài runtime xử lý"
	@echo "  make -f Makefile.studio up             # bật API + worker + web (tự tìm port trống)"
	@echo "  make -f Makefile.studio down           # kill tiến trình đang giữ port của stack"
	@echo "  make -f Makefile.studio status         # in port/pid hiện tại"
	@echo "  make -f Makefile.studio env            # sinh scripts/gpu/studio.env (FORCE_ENV=1 để sinh lại)"
	@echo "  make -f Makefile.studio data-pack [OUT=file]      # đóng gói dữ liệu gửi teammate"
	@echo "  make -f Makefile.studio data-unpack DATA=file     # khôi phục gói dữ liệu (FORCE=1 để thay dữ liệu đang có)"
	@echo "  make -f Makefile.studio account EMAIL=a@b NAME='Tên'  # tạo tài khoản Reviewer"
	@echo "  make -f Makefile.studio samples SAMPLES=dir       # đưa bộ mẫu video + gói LiDAR vào danh sách file"
	@echo "  make -f Makefile.studio docker         # chạy bằng Docker (chỉ xem)"
	@echo ""
	@echo "  Tham số: API_PORT=$(API_PORT) WEB_PORT=$(WEB_PORT) FRONTEND_MODE=$(FRONTEND_MODE) DEMO_DIR=$(DEMO_DIR)"

## start: một lệnh cho máy mới — cài, khôi phục dữ liệu (nếu đưa DATA=...), rồi bật stack.
start: setup
	@if [ -n "$(DATA)" ]; then \
	  if [ -f "$(ROOT)/data/studio_local/runtime.db" ] && [ "$(FORCE)" != "1" ]; then \
	    echo "[data] máy này đã có dữ liệu, bỏ qua DATA=$(DATA) (thêm FORCE=1 để thay)."; \
	  else "$(VENV_PY)" "$(ROOT)/scripts/studio/data_package.py" unpack "$(DATA)" $(if $(filter 1,$(FORCE)),--force,); fi; \
	fi
	@$(MAKE) -f Makefile.studio up

## setup: cài phụ thuộc (không cần sudo; thiếu công cụ nền thì in lệnh cài).
setup:
	@"$(ROOT)/scripts/studio/bootstrap.sh"

setup-runtime:
	@"$(ROOT)/scripts/studio/bootstrap.sh" --runtime

## data-pack / data-unpack: dữ liệu Studio (database + artifact + mẫu) dưới dạng một file.
data-pack:
	@"$(VENV_PY)" "$(ROOT)/scripts/studio/data_package.py" pack $(if $(OUT),--out "$(OUT)",)

data-unpack:
	@[ -n "$(DATA)" ] || { echo "Cần DATA=<file gói>"; exit 1; }
	@"$(VENV_PY)" "$(ROOT)/scripts/studio/data_package.py" unpack "$(DATA)" $(if $(filter 1,$(FORCE)),--force,)

## account: tạo tài khoản Reviewer đầu tiên (mật khẩu nhập ẩn). Chỉ cần khi AUTH_REQUIRED=true.
account: env
	@[ -n "$(EMAIL)" ] && [ -n "$(NAME)" ] || { echo "Cần EMAIL=... NAME=..."; exit 1; }
	@set -a; . "$(ENV_FILE)"; set +a; \
	 "$(VENV_PY)" -m src.services.orchestration.auth.cli create-user --email "$(EMAIL)" --name "$(NAME)" --role reviewer

## samples: đưa bộ mẫu video + gói LiDAR (scripts/demo/make_torwic_lidar_samples.py) vào danh sách file để chọn.
samples: env
	@[ -n "$(SAMPLES)" ] || { echo "Cần SAMPLES=<thư mục bộ mẫu>"; exit 1; }
	@set -a; . "$(ENV_FILE)"; set +a; "$(VENV_PY)" -m scripts.studio.seed_samples --dir "$(SAMPLES)"

## docker: API + web trong container, dữ liệu mount từ ./data (chỉ xem; xử lý job cần cài native với GPU).
docker:
	@docker compose -f "$(ROOT)/docker-compose.studio.yml" up --build

docker-down:
	@docker compose -f "$(ROOT)/docker-compose.studio.yml" down

## env: tạo file cấu hình runtime cho máy này (không ghi đè nếu đã có).
env:
	@FORCE_ENV="$(FORCE_ENV)" DEMO_DIR="$(DEMO_DIR)" "$(ROOT)/scripts/studio/make_env.sh" "$(ENV_FILE)"

## up: chạy API + worker + web; Ctrl+C dọn cả ba và giải phóng port.
up: env
	@$(PORT_HELPERS)
	@for path in "$(VENV_PY)" "$(STACK)"; do \
	  [ -e "$$path" ] || { echo "[!] Thiếu: $$path — chạy: make -f Makefile.studio setup"; exit 1; }; \
	done
	@[ -d "$(ROOT)/frontend/node_modules" ] || { echo "[!] Thiếu frontend/node_modules — chạy: make -f Makefile.studio setup"; exit 1; }
	@api=$$(free_port_or_die "API" "$(API_PORT)"); \
	 web=$$(free_port_or_die "Web" "$(WEB_PORT)"); \
	 mkdir -p "$(dir $(PORT_STATE))"; \
	 printf 'API_PORT=%s\nWEB_PORT=%s\n' "$$api" "$$web" > "$(PORT_STATE)"; \
	 set_env() { \
	   local key="$$1" value="$$2" tmp; \
	   if grep -qE "^$$key=" "$(ENV_FILE)"; then \
	     tmp=$$(mktemp); sed -E "s|^$$key=.*|$$key=$$value|" "$(ENV_FILE)" > "$$tmp"; mv "$$tmp" "$(ENV_FILE)"; \
	   else printf '%s=%s\n' "$$key" "$$value" >> "$(ENV_FILE)"; fi; \
	 }; \
	 set_env APP_PORT "$$api"; set_env STUDIO_WEB_PORT "$$web"; \
	 set_env REAL2SIM_API_URL "http://127.0.0.1:$$api"; \
	 echo ""; \
	 echo "  Studio : http://localhost:$$web   (landing; app: http://localhost:$$web/overview)"; \
	 echo "  API    : http://127.0.0.1:$$api/docs"; \
	 echo "  Video mẫu: http://localhost:$$web/new"; \
	 echo "  Dừng   : Ctrl+C (tự kill các port trên)"; \
	 echo ""; \
	 cleanup() { \
	   trap - INT TERM EXIT; \
	   echo ""; echo "[stop] dừng FastAPI + worker + Next.js…"; \
	   [ -n "$${STACK_PID:-}" ] && kill -TERM "$$STACK_PID" 2>/dev/null || true; \
	   sleep 1; \
	   kill_port "$$web"; kill_port "$$api"; \
	   echo "[stop] xong."; \
	 }; \
	 trap cleanup INT TERM EXIT; \
	 workers="$${STUDIO_WORKERS:-1}"; \
	 if [ ! -x "$(BRUSH)" ] || [ ! -f "$(SPLAT)" ] || [ ! -f "$(COLMAP)" ] || ! command -v docker >/dev/null; then \
	   workers=0; \
	   echo "  [chế độ chỉ xem] Máy này chưa có runtime xử lý (Brush / splat-transform / COLMAP-docker):"; \
	   echo "  mở và chỉnh scene có sẵn được, job mới sẽ nằm chờ. Cài: make -f Makefile.studio setup-runtime"; \
	   echo ""; \
	 fi; \
	 STUDIO_WORKERS="$$workers" STUDIO_FRONTEND="$(FRONTEND_MODE)" "$(STACK)" "$(ENV_FILE)" & \
	 STACK_PID=$$!; \
	 wait "$$STACK_PID" || true

## down: kill tiến trình đang giữ port của lần chạy gần nhất.
down:
	@$(PORT_HELPERS)
	@if [ -f "$(PORT_STATE)" ]; then . "$(PORT_STATE)"; else API_PORT="$(API_PORT)"; WEB_PORT="$(WEB_PORT)"; fi; \
	 kill_port "$$WEB_PORT"; kill_port "$$API_PORT"; rm -f "$(PORT_STATE)"

## status: port nào đang bị ai chiếm.
status:
	@$(PORT_HELPERS)
	@if [ -f "$(PORT_STATE)" ]; then . "$(PORT_STATE)"; else API_PORT="$(API_PORT)"; WEB_PORT="$(WEB_PORT)"; fi; \
	 for entry in "API:$$API_PORT" "Web:$$WEB_PORT"; do \
	   label=$${entry%%:*}; port=$${entry##*:}; \
	   if port_busy "$$port"; then echo "[status] $$label :$$port ĐANG CHẠY (PID $$(port_owner "$$port"))"; \
	   else echo "[status] $$label :$$port trống"; fi; \
	 done
