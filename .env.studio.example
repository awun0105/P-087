# Copy thành .env.studio trên máy teammate; không gửi file thật vào ZIP/Git.
# API Studio cần giá trị provider để khởi tạo Settings. Placeholder này không
# gọi được chat LLM; nếu dùng chat thì thay bằng key riêng của teammate.
LLM_PROVIDER=openai
OPENAI_API_KEY=not-used-by-studio

# Gói team hiện tại giữ hai tài khoản seed: có thể đăng nhập bằng mật khẩu cũ.
# Chỉ điền các dòng dưới nếu gói không có Reviewer active và cần tạo tài khoản mới.
# Email mới không được trùng attribution account đã disable; password ít nhất 10 ký tự.
# Bọc password có ký tự $/#/space trong nháy đơn để dotenv không nội suy.
R2S_BOOTSTRAP_EMAIL=
R2S_BOOTSTRAP_NAME=
R2S_BOOTSTRAP_ROLE=reviewer
R2S_BOOTSTRAP_PASSWORD=

# Cấu hình host được Compose đọc qua --env-file .env.studio.
STUDIO_DATA_DIR=./data
STUDIO_DATA_ARCHIVE=./r2s-studio-data.zip
STUDIO_API_PORT=8010
STUDIO_WEB_PORT=3010

# Giữ default trên Windows/macOS/Linux. Chỉ đổi host trên Linux nếu Docker
# bridge của host không resolve được DNS trong lúc build image.
STUDIO_BUILD_NETWORK=default

# Cấu hình file Compose mặc định:
# - Mặc định (có GPU NVIDIA): khởi động cả Web, API và Worker xử lý pipeline
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# - Máy CPU (không có GPU NVIDIA): bỏ ghi chú dòng dưới và chú thích dòng trên để chạy riêng Web/API
# COMPOSE_FILE=docker-compose.yml
