# Real2Sim Studio API on Railway.
# Copy these names into Railway service variables.  Keep the values below empty
# until the operator supplies the real secret/endpoint; never commit a filled file.

APP_ENV=production
LOG_LEVEL=INFO

# Railway volume mount thuộc root. Entrypoint chuẩn bị đúng /app/data rồi hạ
# quyền xuống appuser UID1000 trước khi chạy API; không phục vụ request bằng root.
RAILWAY_RUN_UID=0
R2S_PREPARE_VOLUME=true

# Railway injects PORT.  Dockerfile uses it; do not pin a competing port here.
# PORT=

# Supabase shared pooler, session mode: host from Dashboard > Connect, port 5432,
# and sslmode=require (or verify-full with the downloaded CA certificate).
DATABASE_URL=

# Cache trên volume /app/data; source of truth của published artifacts vẫn là R2.
# Thumbnail cache dùng thư mục sibling studio_local/thumbnail_cache.
ARTIFACT_ROOT=/app/data/studio_local/artifacts
PRODUCT_WORKER_ROOT=/app/data/studio_local/workers
PRODUCT_TRASH_ROOT=/app/data/studio_local/trash
CHROMA_PERSIST_DIR=/app/data/studio_local/chroma
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_PREFIX=prod
ARTIFACT_PRESIGN_SECONDS=900

# The Next.js same-origin proxy carries the httpOnly cookie to this API.
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=7
AUTH_INVITE_DAYS=7
CORS_ORIGINS=

# Production privacy gate.  Do not use self_attested as a deployment shortcut.
PRODUCT_PRIVACY_MODE=qa_verified
PRODUCT_OBJECTIFY=true
PRODUCT_OBJECTIFY_REMOTE_WORKER=true

# Both paths must be supplied together after a real worker preflight.  A
# fabricated or laptop-only runtime manifest cannot authorize a new worker.
# PRODUCT_PROCESSING_CONFIG=/app/configs/product/processing_presets_v1.json
# PRODUCT_RUNTIME_MANIFEST=/app/data/studio_local/runtime_manifest.json

# Optional local-only data roots are intentionally unset.  demo/library,
# asset_previews, and rerun_recordings are not remote artifact-backed yet.
# If the Railway API service is provisioned with the documented auxiliary
# volume, set these to its absolute mount paths instead:
# PRODUCT_DEMO_DIR=/app/data/demo/library
# PRODUCT_ASSET_PREVIEW_DIR=/app/data/asset_previews
# PRODUCT_RERUN_RECORDING_DIR=/app/data/rerun_recordings

# Current Settings validates the selected LLM provider at startup even though
# Studio's production routes do not use chat.  Supply a real key or change the
# provider through an approved code/config decision; no default credential is
# provided here.
LLM_PROVIDER=openai
OPENAI_API_KEY=
