# Real2Sim Studio — cấu hình production, MỘT nguồn duy nhất.
#
# Chép file này thành một file riêng ngoài repo (ví dụ /secure/production.env), điền giá trị, rồi:
#
#   python -m scripts.studio.deploy_env check  --source /secure/production.env
#   python -m scripts.studio.deploy_env render --source /secure/production.env --out-dir /secure/out
#
# `render` sinh api.env (Railway), worker.env (pod GPU, Dockerfile.gpu) và web.env (Vercel). Mọi biến trong phần
# [shared] được ghi giống hệt nhau vào api.env và worker.env, nên không thể lệch. Không sửa tay ba file sinh ra,
# và không commit file đã điền. Giá trị để trống ở đây là giá trị người vận hành bắt buộc phải điền.
#
# Ba file `*.env.example` cạnh file này được sinh từ chính file này (`render --examples`); sửa ở đây rồi sinh lại.

# [shared]
APP_ENV=production

# PostgreSQL dùng chung cho API và worker. Supabase shared pooler, session mode: host lấy từ Dashboard > Connect,
# cổng 5432, kèm sslmode=require (hoặc verify-full với CA đã tải).
DATABASE_URL=

# Kho artifact Cloudflare R2. Một bucket và một prefix cho cả API lẫn worker.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_PREFIX=prod

AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=true

# Chế độ privacy. Mặc định self_attested (owner chốt 2026-10-09): production chạy được ngay cả khi pod chưa có
# trọng số EgoBlur. Đổi sang qa_verified sau khi worker đã có bộ che.
#   self_attested  người upload tự cam kết video không có khuôn mặt/biển số (chế độ của MVP, owner chốt
#                  2026-09-29). Người dùng tự chọn có che hay không theo từng job.
#   qa_verified    mọi video bị che khuôn mặt/biển số tự động; nếu có frame bị che, job dừng chờ người upload
#                  xem và xác nhận rồi mới dựng 3D (AUD-18). Cần bộ che: PRODUCT_EGOBLUR_WEIGHTS ở [worker] và
#                  PRODUCT_ANONYMIZE_REMOTE_WORKER=true ở [api]; thiếu thì `check` báo lỗi.
PRODUCT_PRIVACY_MODE=self_attested

PRODUCT_OBJECTIFY=true

# COLMAP trích đặc trưng và so khớp trên GPU. API ghi giá trị này vào cấu hình job, worker thực thi: hai bên phải
# giống nhau (AUD-26.S5).
PRODUCT_COLMAP_USE_GPU=true

# Bắt buộc che khuôn mặt/biển số cho mọi job (AUD-18). false = người dùng tự chọn theo từng job, và chỉ khi
# worker có trọng số EgoBlur (xem PRODUCT_EGOBLUR_WEIGHTS ở [worker] và PRODUCT_ANONYMIZE_REMOTE_WORKER ở [api]).
PRODUCT_ANONYMIZE_INPUT=false

# Settings kiểm khóa của LLM provider đã chọn lúc khởi động dù các route của Studio không dùng chat. Để trống có
# chủ ý: điền khóa thật do người vận hành duyệt. Image GPU có giá trị giữ chỗ khi biến rỗng; không coi đó là
# credential production.
LLM_PROVIDER=openai
OPENAI_API_KEY=

# [api]
# Dịch vụ API trên Railway (Dockerfile). Chép các biến vào Railway service variables.
LOG_LEVEL=INFO

# Volume Railway mount thuộc root. Entrypoint chuẩn bị /app/data rồi hạ quyền xuống appuser UID 1000 trước khi
# chạy API; không phục vụ request bằng root. Railway tự cấp PORT, không đặt PORT ở đây.
RAILWAY_RUN_UID=0
R2S_PREPARE_VOLUME=true

# Cache trên volume /app/data; nguồn gốc của artifact đã publish vẫn là R2.
ARTIFACT_ROOT=/app/data/studio_local/artifacts
PRODUCT_WORKER_ROOT=/app/data/studio_local/workers
PRODUCT_TRASH_ROOT=/app/data/studio_local/trash
CHROMA_PERSIST_DIR=/app/data/studio_local/chroma
ARTIFACT_PRESIGN_SECONDS=900

# Proxy cùng origin của Next.js mang cookie httpOnly tới API, nên thường không cần CORS.
AUTH_SESSION_DAYS=7
AUTH_INVITE_DAYS=7
CORS_ORIGINS=

# Bước tách vật và bộ che chạy ở worker máy khác; API không tự kiểm được runtime của worker nên khai bằng cờ.
PRODUCT_OBJECTIFY_REMOTE_WORKER=true
# true khi worker đã có trọng số EgoBlur: form tạo scene mới hiện ô "Tự động che khuôn mặt và biển số".
PRODUCT_ANONYMIZE_REMOTE_WORKER=false

# Phải có cả hai thì API mới nhận tạo scene. Runtime manifest là file do CHÍNH pod worker sinh ra
# (scripts.gpu.make_runtime_manifest, entrypoint của image GPU tự chạy): chép file đó lên volume của API. Job mang
# checksum của manifest này và worker chỉ nhận job có checksum trùng manifest của nó, nên đổi pod sang GPU hay
# driver khác là phải chép lại manifest mới và khởi động lại API.
PRODUCT_PROCESSING_CONFIG=/app/configs/product/processing_presets_v1.json
PRODUCT_RUNTIME_MANIFEST=/app/data/studio_local/runtime_manifest.json
# PRODUCT_INPUT_RUNTIME_REGISTRY=/app/data/input_runtime_registry.json

# Dữ liệu tùy chọn chỉ có trên đĩa cục bộ (không nằm trên R2). Đặt khi volume của API có các thư mục này.
# PRODUCT_DEMO_DIR=/app/data/demo/library
# PRODUCT_ASSET_PREVIEW_DIR=/app/data/asset_previews
# PRODUCT_RERUN_RECORDING_DIR=/app/data/rerun_recordings

# [worker]
# GPU worker (Dockerfile.gpu) trên Vast.ai hoặc RunPod. Image chứa COLMAP, Brush 0.3.0 và splat-transform 3.6.6;
# host phải cấp NVIDIA + Vulkan. Worker đọc thẳng PostgreSQL và R2 dùng chung.
ARTIFACT_ROOT=/data/artifacts
PRODUCT_WORKER_ROOT=/data/workers
PRODUCT_OBJECTIFY_REMOTE_WORKER=false
PRODUCT_PROCESSING_CONFIG=/opt/real2sim/app/configs/product/processing_presets_v1.json
PRODUCT_RUNTIME_MANIFEST=/data/runtime_manifest.json
# PRODUCT_INPUT_RUNTIME_REGISTRY=/data/input_runtime_registry.json
PRODUCT_SCENE_RUNTIME_PYTHON=/opt/real2sim/scene_runtime/bin/python
PRODUCT_SAM2_CHECKPOINT=/opt/real2sim/scene_runtime/checkpoints/sam2.1_hiera_tiny.pt
PRODUCT_LAMA_CHECKPOINT=/opt/real2sim/scene_runtime/weights/big-lama.pt

# Thư mục chứa ego_blur_face_gen2.jit và ego_blur_lp_gen2.jit (AUD-18). Trọng số chỉ tải được từ
# projectaria.com/tools/egoblur sau khi đồng ý giấy phép, nên image không có sẵn. Làm MỘT lần từ máy có hai file:
#   python -m scripts.gpu.egoblur_weights upload --from <thư mục chứa hai file>
# Từ đó mọi pod có biến này tự tải về và kiểm sha256 lúc khởi động; không lấy được thì pod dừng kèm lý do.
# Để dạng comment = worker không có bộ che; khi đó PRODUCT_ANONYMIZE_REMOTE_WORKER phải là false. Không đặt giá
# trị rỗng: Settings sẽ hiểu chuỗi rỗng là thư mục hiện tại.
# PRODUCT_EGOBLUR_WEIGHTS=/data/egoblur

# Số worker theo pod: 3 cho pod RTX 3090 16 vCPU (125 GB RAM), 2 cho pod RTX 4090 6 vCPU (41 GB RAM). Giá trị
# khởi đầu, chờ đo trên pod (AUD-26 Sprint S4). Không dùng `auto` ở production.
STUDIO_WORKERS=3

# [web]
# Biến của project Vercel (thư mục gốc `frontend/`, Node.js 24.x). Dùng lúc build bởi frontend/next.config.ts:
# origin công khai của API trên Railway, không kèm /api/v1. Không phải secret.
REAL2SIM_API_URL=
