# Vercel project variables for the Next.js frontend.
# This value is used at build time by frontend/next.config.ts.  It is not a
# browser secret and must be the public Railway API origin, without a trailing
# /api/v1 suffix.
REAL2SIM_API_URL=

# Set Build and Deployment > Node.js Version to 24.x in Vercel.  The repository
# CI baseline is Node 24; this comment is documentation, not an API secret.
