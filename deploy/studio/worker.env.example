# Real2Sim GPU worker (Vast.ai primary / RunPod fallback).
# Use Dockerfile.gpu.  This worker reads the shared Postgres/R2 state directly
# in the current implementation; see deploy/studio/README.md for the boundary.

APP_ENV=production
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=true
PRODUCT_PRIVACY_MODE=qa_verified

# Shared state.  Use the Supabase session pooler URL with sslmode=require.
DATABASE_URL=
ARTIFACT_ROOT=/data/artifacts
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_PREFIX=prod

# The image contains native COLMAP, Brush 0.3.0 and splat-transform 3.6.6.
# It does not run Docker inside Docker.  The host must expose NVIDIA + Vulkan.
PRODUCT_OBJECTIFY=true
PRODUCT_OBJECTIFY_REMOTE_WORKER=false
PRODUCT_WORKER_ROOT=/data/workers
PRODUCT_PROCESSING_CONFIG=/opt/real2sim/app/configs/product/processing_presets_v1.json
PRODUCT_RUNTIME_MANIFEST=/data/runtime_manifest.json
# Mount the same checksum-verified recipe registry used by the API.
# PRODUCT_INPUT_RUNTIME_REGISTRY=/data/input_runtime_registry.json
PRODUCT_SCENE_RUNTIME_PYTHON=/opt/real2sim/scene_runtime/bin/python
PRODUCT_SAM2_CHECKPOINT=/opt/real2sim/scene_runtime/checkpoints/sam2.1_hiera_tiny.pt
PRODUCT_LAMA_CHECKPOINT=/opt/real2sim/scene_runtime/weights/big-lama.pt
STUDIO_WORKERS=auto

# The current worker entrypoint validates this provider key through Settings.
# Keep empty in the template and supply an operator-approved real value at run
# time; do not copy a laptop .env or put a key in the image.
LLM_PROVIDER=openai
OPENAI_API_KEY=
