# Studio MVP runtime — copy thành scripts/gpu/studio.env (không commit) rồi sửa đường dẫn.
# Giá trị JSON phải bọc nháy đơn vì run_stack.sh `source` file này bằng bash.
# Mọi đường dẫn nên là tuyệt đối trên máy chạy worker.

# ── Backend chung ────────────────────────────────────────────────────────────
APP_ENV=development
LLM_PROVIDER=openai
OPENAI_API_KEY=not-used-by-studio
DATABASE_URL=sqlite:////opt/real2sim/state/runtime.db
ARTIFACT_ROOT=/opt/real2sim/state/artifacts

# ---- Kho file S3-compatible (ADR 0003; để trống = chỉ filesystem local) ----
# R2: endpoint https://<account_id>.r2.cloudflarestorage.com, region auto.
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_ENDPOINT=
# ARTIFACT_S3_REGION=auto
# ARTIFACT_S3_ACCESS_KEY_ID=
# ARTIFACT_S3_SECRET_ACCESS_KEY=
# ARTIFACT_S3_PREFIX=
# ARTIFACT_PRESIGN_SECONDS=900

# ---- Đăng nhập hai role (ADR 0003 §3) ----
# Bật trên deployment cloud; tạo Reviewer đầu tiên:
#   python -m src.services.orchestration.auth.cli create-user --email ... --name ... --role reviewer
AUTH_REQUIRED=true
# AUTH_SESSION_DAYS=7
# AUTH_INVITE_DAYS=7

# ---- Benchmark (plan Cloud Studio mục 9) ----
# BENCHMARK_GPU_HOURLY_USD=0.34
# BENCHMARK_LABEL=
PRODUCT_WORKER_ROOT=/opt/real2sim/state/workers

# MVP: người upload tự xác nhận video không có khuôn mặt/biển số (quyết định owner 2026-09-29).
PRODUCT_PRIVACY_MODE=self_attested
PRODUCT_UPLOAD_MAX_BYTES=4294967296

# File cấu hình xử lý CHUNG: thông số chỉnh được, giới hạn, preset, hệ số ước lượng
# tài nguyên. Người dùng chọn thông số trên UI trong giới hạn của file này.
PRODUCT_PROCESSING_CONFIG=/opt/real2sim/app/configs/product/processing_presets_v1.json
# Bật GPU cho bước trích đặc trưng và so khớp của COLMAP (máy dev local không có NVIDIA driver trong container thì để false).
# PRODUCT_COLMAP_USE_GPU=false
# Che khuôn mặt/biển số trên frame trước khi dựng 3D (AUD-18). Cần PRODUCT_SCENE_RUNTIME_PYTHON và hai file .jit
# của EgoBlur Gen2 (tải từ projectaria.com/tools/egoblur, xem scripts/gpu/setup_scene_runtime.sh).
# PRODUCT_ANONYMIZE_INPUT=false
# PRODUCT_EGOBLUR_WEIGHTS=/opt/real2sim/scene_runtime/weights
# Runtime manifest sinh trên chính máy này:
#   python -m scripts.gpu.make_runtime_manifest --out /opt/real2sim/state/runtime_manifest.json
PRODUCT_RUNTIME_MANIFEST=/opt/real2sim/state/runtime_manifest.json
PRODUCT_PREVIEW_TIMEOUT_SECONDS=21600

# Thư viện video mẫu: mỗi thư mục con là một bundle export từ job thật
# (scripts/demo/export_demo_bundle.py --out <thư viện>/<id-mẫu> job --job-id ...).
PRODUCT_DEMO_DIR=/opt/real2sim/state/demo/library

# ── EX-REC tools (process boundary) ──────────────────────────────────────────
# COLMAP chạy trong container pin theo digest; launcher mount thư mục làm việc.
REC03_COLMAP_COMMAND='["sh","/opt/real2sim/runtime/colmap-launcher.sh"]'
REC03_COLMAP_RUNTIME_IDENTITY=colmap-image-sha256:b8498ebecab11c3f9b9a25370e3fcfb6de9b6bcd4f3c85d5dc39a40229f40954
REC03_COLMAP_TIMEOUT_SECONDS=7200

# Brush 0.3.0 (Vulkan). Trên GPU NVIDIA dùng ICD nvidia.
REC04_BRUSH_COMMAND='["/opt/real2sim/runtime/brush/brush_app"]'
REC04_BRUSH_EXPECTED_VERSION=0.3.0
REC04_BRUSH_ENVIRONMENT='{"RUST_LOG":"info,wgpu_core=warn","VK_ICD_FILENAMES":"/usr/share/vulkan/icd.d/nvidia_icd.json"}'
REC04_BRUSH_RUNTIME_IDENTITY=brush-v0.3.0-linux-archive-sha256:4f0f9a8785d1951c62df26aae247c02c5bba32b00f40b06df4e1c9b867399e20
REC04_BRUSH_TIMEOUT_SECONDS=14400
# Checkpoint khi train (số bước giữa hai lần xuất; 0 = tắt). Retry sau khi đứt sẽ train tiếp từ bản mới nhất.
# REC04_BRUSH_CHECKPOINT_EVERY=2500

# splat-transform 3.6.6 (Node) cho SOG delivery. Nén SOG dùng GPU (WebGPU/Dawn,
# nhanh hơn CPU rất nhiều); đặt REC04_SPLAT_DEVICE=cpu chỉ khi GPU lỗi.
REC04_SPLAT_DEVICE=gpu
REC04_SPLAT_MODULE_PATH=/opt/real2sim/runtime/node_modules/@playcanvas/splat-transform/dist/index.mjs

# REC-05 (bước hoàn tất sau xác nhận tỉ lệ): cùng splat-transform 3.6.6, gọi qua CLI.
REC05_VOXEL_CLI=/opt/real2sim/runtime/node_modules/@playcanvas/splat-transform/bin/cli.mjs
REC05_VOXEL_MODULE_PATH=/opt/real2sim/runtime/node_modules/@playcanvas/splat-transform/dist/index.mjs
REC05_VOXEL_TIMEOUT_SECONDS=1800
# Profile indoor bật external fill 1.6 m trước carve (chưa hiệu chỉnh trên scene thật).
# Thông số voxel/capsule và GPU adapter theo máy: xem
# `node <REC05_VOXEL_CLI> --list-gpus`; máy có iGPU + card rời thường là 1.
PRODUCT_GEOMETRY_CONFIG=/opt/real2sim/app/configs/product/geometry_indoor_v1.json
# PRODUCT_GEOMETRY_GPU_INDEX=1
# Tách vật thể SAMPro3D + SAM2 (ADR 0006): venv riêng có torch + sam2 và checkpoint
# sam2.1_hiera_tiny.pt. Bỏ trống → fallback tách hình học từ collision mesh.
# PRODUCT_SCENE_RUNTIME_PYTHON=/opt/real2sim/scene_runtime/bin/python
# PRODUCT_SAM2_CHECKPOINT=/opt/real2sim/scene_runtime/checkpoints/sam2.1_hiera_tiny.pt
# PRODUCT_SCENE_TIMEOUT_SECONDS=1800
# Số lần thử tách theo vật trước khi dừng và để người dùng chọn (chạy lại / dùng hộp ứng viên).
# PRODUCT_OBJECTIFY_ATTEMPTS=3
# Đặt true trên API khi worker tách theo vật chạy ở máy khác (ADR 0003 cách C).
# PRODUCT_OBJECTIFY_REMOTE_WORKER=false
# Số worker: 1 (mặc định local) | auto | N — chia theo VRAM từng GPU (scripts/gpu/gpu_plan.py).
# Trên pod RunPod: 3 cho RTX 3090 16 vCPU, 2 cho RTX 4090 6 vCPU (xem task AUD-26 Sprint S4).
# STUDIO_WORKERS=1
# Pipeline v2 (ADR 0007): runtime trên cần thêm gsplat, coacd, scikit-image, trimesh, opencv, usd-core.
# Trọng số LaMa (big-lama.pt, TorchScript) cho vá nền; thiếu thì dùng cv2.inpaint.
# PRODUCT_LAMA_CHECKPOINT=/opt/real2sim/scene_runtime/weights/big-lama.pt

# Đề xuất tỉ lệ mét và mặt sàn tự động cho video chỉ có RGB (ADR 0001 §2): MoGe-2 trong cùng runtime trên.
# Để trống thì không có đề xuất; người dùng xác nhận tỉ lệ bằng số đo tay như cũ. Kết quả luôn là ước lượng.
# REC06_MOGE_PYTHON=/opt/real2sim/scene_runtime/bin/python
# REC06_MOGE_MODEL=/opt/real2sim/scene_runtime/weights/moge-2-vitb-normal.pt

# LPIPS trên ảnh giữ lại sau khi train 3DGS (PSNR/SSIM do Brush tự chấm, không cần biến này): Python của runtime
# trên, có gói `lpips`. Để trống thì bảng chỉ số ghi LPIPS "chưa đo".
# REC04_BRUSH_LPIPS_PYTHON=/opt/real2sim/scene_runtime/bin/python
# PRODUCT_OBJECTIFY=true

# ── Frontend ─────────────────────────────────────────────────────────────────
REAL2SIM_API_URL=http://127.0.0.1:8000
